<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DarApplicationIconPath>$(MSBuildProjectDirectory)\..\assets\dar-eltahfeez.ico</DarApplicationIconPath>
    <ApplicationIcon Condition="Exists('$(DarApplicationIconPath)')">$(DarApplicationIconPath)</ApplicationIcon>
    <AssemblyName>DarEltahfeez.Desktop</AssemblyName>
    <Title>دار الإمام حفص للقرآن والتجويد</Title>
    <Product>دار الإمام حفص للقرآن والتجويد</Product>
    <Description>تطبيق إدارة دار الإمام حفص للقرآن والتجويد</Description>
    <Company>دار الإمام حفص</Company>
    <Version>0.8.25.0</Version>
    <AssemblyVersion>0.8.25.0</AssemblyVersion>
    <FileVersion>0.8.25.0</FileVersion>
    <RootNamespace>DarEltahfeez.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <Target Name="WarnIfDarApplicationIconMissing" BeforeTargets="CoreCompile" Condition="!Exists('$(DarApplicationIconPath)')">
    <Message Importance="high" Text="DAR BUILD WARNING: branded icon not found at $(DarApplicationIconPath). Continuing with the default Windows executable icon; the application build is not blocked." />
  </Target>
</Project>
