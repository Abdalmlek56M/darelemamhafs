<Window x:Class="DarEltahfeez.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="دار الإمام حفص للقرآن والتجويد"
        Width="1440" Height="940" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="TitleBarSurface" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0" FlowDirection="LeftToRight">
          <Border Width="25" Height="25" CornerRadius="7" Background="#17332F" Margin="0,0,9,0">
            <TextBlock Text="۞" FontSize="19" Foreground="#70D6C2" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="TitleBarPrimaryText" Text="دار الإمام حفص للقرآن والتجويد" Foreground="{DynamicResource TitleBarPrimaryForeground}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock x:Name="TitleBarSecondaryText" Text="  ·  نسخة سطح المكتب" Foreground="{DynamicResource TitleBarSecondaryForeground}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,7,0">
          <Button x:Name="TitleBarReloadButton" Style="{StaticResource TitleBarWindowButton}" Width="38" Height="34" Click="Reload_Click" ToolTip="إعادة تحميل التطبيق (F5)" AutomationProperties.Name="إعادة تحميل التطبيق">
            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource TitleBarActionForeground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 20,11 A 8,8 0 0 0 5.6,6.6 L 3,9 M 3,4 L 3,9 L 8,9 M 4,13 A 8,8 0 0 0 18.4,17.4 L 21,15 M 21,20 L 21,15 L 16,15" />
          </Button>
          <Border x:Name="TitleBarDivider" Width="1" Height="22" Background="{DynamicResource TitleBarDividerBrush}" Margin="5,0" />
          <Button x:Name="TitleBarMinimizeButton" Style="{StaticResource TitleBarWindowButton}" Content="—" Click="Minimize_Click" ToolTip="تصغير" />
          <Button x:Name="TitleBarMaximizeButton" Style="{StaticResource TitleBarWindowButton}" Content="□" Click="Maximize_Click" ToolTip="تكبير / استعادة" />
          <Button x:Name="TitleBarCloseButton" Style="{StaticResource TitleBarCloseButton}" Content="×" Click="Close_Click" ToolTip="إغلاق" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />
      <Border x:Name="LoadingPanel" Background="{StaticResource AppBackground}" Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
          <Border Width="64" Height="64" CornerRadius="18" Background="#DCEFEA" HorizontalAlignment="Center" Margin="0,0,0,22">
            <TextBlock Text="۞" FontSize="38" Foreground="{StaticResource AppAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="دار الإمام حفص للقرآن والتجويد" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AppForeground}" TextAlignment="Center" Margin="0,0,0,10" />
          <TextBlock x:Name="StatusText" Text="جاري تجهيز التطبيق..." FontSize="14" Foreground="#62728A" TextAlignment="Center" TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True" Height="4" Width="250" Margin="0,24,0,0" Background="#DBE4EC" Foreground="{StaticResource AppAccent}" BorderThickness="0" />
        </StackPanel>
      </Border>
      <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="{StaticResource AppBackground}" Padding="36">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
          <TextBlock Text="تعذّر فتح الدار" FontSize="24" FontWeight="SemiBold" Foreground="#B42318" TextAlignment="Center" Margin="0,0,0,12" />
          <TextBlock x:Name="ErrorText" Text="تعذّر الاتصال بالخدمة." FontSize="14" Foreground="{StaticResource AppForeground}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,22" />
          <WrapPanel HorizontalAlignment="Center">
            <Button Content="إعادة المحاولة" Padding="22,10" Margin="5" Background="{StaticResource AppAccent}" Foreground="White" BorderThickness="0" Click="Retry_Click" />
            <Button Content="إعداد الاتصال" Padding="22,10" Margin="5" Background="#E2E8F0" Foreground="{StaticResource AppForeground}" BorderThickness="0" Click="ConfigureConnection_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
