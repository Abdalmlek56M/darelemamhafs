# Restore drill environment (installed as /etc/dar/restore-drill.env, mode 600).
# The drill never writes to production; it restores into disposable databases only.
# The production database name is required so the script can refuse to write to it.
RESTORE_DRILL_PROD_DB=change-me-live-db
# Local verified backup directory read by the drill.
# RESTORE_DRILL_BACKUP_DIR=/var/lib/dar/backups/db
# rclone remote path for the off-site copy check; leave empty to skip that check.
# RESTORE_DRILL_REMOTE_PATH=
# Legacy app port used by the disposable restore smoke check.
# RESTORE_DRILL_APP_PORT=5101
