# Copy this file to /etc/dar/smoke.env (mode 600 root:dar, or 640 root:dar) to
# enable the post-swap smoke in deploy/update.sh and deploy/rollback-db.sh.
#
# These are REAL login credentials used by the deploy host itself: use a dedicated
# admin account, not a personal one. The password is never printed, never passed on
# a command line and never written to the update log - it is only read into a
# 0600 temporary request body.
#
# When the file or a value is missing, the real-login smoke is skipped with a
# warning (the seven public HTTP smoke checks still run). A rejected login or a
# missing finance.read permission warns and lets the deploy continue; set
# DAR_SMOKE_STRICT=1 (on the update.sh command line) to make it fatal.
#
# Install:
#   sudo install -m 0640 -o root -g dar deploy/smoke.env.example /etc/dar/smoke.env
#   sudo nano /etc/dar/smoke.env
SMOKE_USERNAME=change-me-admin-username
SMOKE_PASSWORD=change-me-strong-password
