[Unit]
Description=Dar LiveKit media server (test / M0 spike)
Documentation=file:/opt/dar/docs/22-inhouse-meetings-design.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=livekit
Group=livekit
WorkingDirectory=/var/lib/livekit
ExecStart=/usr/local/bin/livekit-server --config /etc/dar/livekit.yaml
Restart=always
RestartSec=3
LimitNOFILE=1048576
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/livekit
EnvironmentFile=/etc/dar/livekit.env

[Install]
WantedBy=multi-user.target
