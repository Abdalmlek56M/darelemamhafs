PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=dareltahfeez
PGUSER=dar_app
PGPASSWORD=change-me
# Optional: gdrive:dar-backups, r2:dar-backups, or b2:dar-backups
RCLONE_REMOTE=

# Optional backup tuning. Defaults preserve the previous behaviour.
# BACKUP_DIR=/var/lib/dar/backups/db
# BACKUP_RETENTION_DAYS=30
# VERIFY_RESTORE_LIST=1
# RCLONE_CONFIG=/var/lib/dar/rclone/rclone.conf
# RCLONE_DEST_SUBDIR=dar/db
# BACKUP_LOCK_FILE=/var/lib/dar/backups/db/.dar-backup.lock

# Optional dar-healthcheck settings (place them in /etc/dar/healthcheck.env).
# HEALTHCHECK_SERVICES="dar-legacy dar-api nginx postgresql"
# HEALTHCHECK_LEGACY_URL=http://127.0.0.1:5080
# HEALTHCHECK_API_URL=http://127.0.0.1:5081
# HEALTHCHECK_TIMEOUT_SECONDS=10
# HEALTHCHECK_DISK_PATH=/var/lib/dar
# HEALTHCHECK_DISK_MIN_FREE_PERCENT=15
# HEALTHCHECK_BACKUP_DIR=/var/lib/dar/backups/db
# HEALTHCHECK_BACKUP_MAX_AGE_HOURS=26
# HEALTHCHECK_CERT_DOMAIN=dar-elemam-hafs.rigxhardware.com
# HEALTHCHECK_CERT_MIN_DAYS=14
# HEALTHCHECK_STRICT=0
