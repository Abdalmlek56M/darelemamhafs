# Copy this file to deploy/.env and replace every change-me value.
# Generate secrets with: openssl rand -hex 32
# deploy/.env is read by deploy/setup-host-*.sh, deploy/setup-nginx.sh, deploy/preflight.sh and
# deploy/update.sh. It is untracked (mode 600) and must never be committed.

DAR_DOMAIN=change-me.example.invalid

# Let's Encrypt account email printed in the certbot command by deploy/setup-nginx.sh.
# Required only on first deploy, while no certificate exists yet. Placeholder only:
# the real address stays in the untracked deploy/.env.
CERTBOT_EMAIL=change-me@example.invalid

# Database created by deploy/setup-host-db.sh and used by deploy/setup-host-services.sh.
# Must be the real database name; never the production name in tracked files/examples.
POSTGRES_DB=change-me-db
POSTGRES_USER=dar_app
POSTGRES_PASSWORD=change-me-hex

# Required by Dar.Api outside Development (OTP HMAC pepper).
OTP_PEPPER=change-me-hex

# Transactional email (optional for first boot; OTP requests fail until configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENABLE_SSL=true

# Optional Google login.
GOOGLE_CLIENT_ID=

# First-run admin bootstrap: setup-host-services.sh writes Auth__SetupToken= (empty) to
# /etc/dar/legacy.env. Remote setup stays disabled while it is empty; loopback setup works.
# If remote first-run setup is needed, set Auth__SetupToken in /etc/dar/legacy.env for the
# single POST /api/setup/admin request and clear it afterwards.

# nginx real-client-IP mode (single setting for the whole site).
# cloudflare = install CF published ranges and trust CF-Connecting-IP only from Cloudflare peers;
# direct     = no proxy header is trusted. Use direct only when Cloudflare is not in front.
DAR_REAL_IP_MODE=cloudflare
