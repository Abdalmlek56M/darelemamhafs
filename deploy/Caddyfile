{$DAR_DOMAIN} {
  encode zstd gzip

  # New OpenAPI/Identity/Secretariat API.
  @new_api path /api/v1/* /health/live /health/ready
  handle @new_api {
    reverse_proxy new-api:8080
  }

  # Legacy full application (React SPA + /api/*).
  handle {
    reverse_proxy legacy-api:8080
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }
}
