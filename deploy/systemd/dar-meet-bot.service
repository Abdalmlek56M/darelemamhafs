[Unit]
Description=Dar Google Meet recorder bot
Documentation=file:/opt/dar/docs/19-meet-operations.md
After=network-online.target dar-api.service
Wants=network-online.target dar-api.service

[Service]
Type=simple
User=dar
Group=dar
Slice=dar-meet.slice
WorkingDirectory=/opt/dar-meet-bot
EnvironmentFile=/etc/dar/meet-bot.env
Environment=HOME=/var/lib/dar
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/dar-meet-bot/dist/index.js
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=45

# A private runtime dir keeps the bot's PulseAudio server away from every other process.
RuntimeDirectory=dar-meet
RuntimeDirectoryMode=0700

# Hardening (ADR-0007 §5). PrivateDevices is intentionally off: Chromium needs /dev/shm.
# /var/lib/dar is writable because the service owns it: PulseAudio writes ~/.config/pulse
# and Chromium keeps its persistent profile under /var/lib/dar/meet.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dar /run/dar-meet
# AF_NETLINK is required: Chromium enumerates network interfaces through it, and without
# it WebRTC loses its candidates and the Meet call dies with "Couldn't start the video call".
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
