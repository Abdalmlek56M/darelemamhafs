[Unit]
Description=Dar meet recorder resource slice
Documentation=file:/opt/dar/docs/adr/0007-meet-recording-architecture.md

[Slice]
# ADR-0007: the recorder may never starve the site or PostgreSQL.
#
# A hard CPUQuota is the wrong tool here: the kernel refills it every 100ms, so x264 and
# Chromium bursts were throttled 58% of the periods (nr_throttled/nr_periods measured on
# production), which froze ffmpeg in 100ms slices - dropped frames and choppy audio. The
# host idles at 92%, so fairness is enforced with nice + CPUWeight instead of a cap.
MemoryMax=3G
CPUWeight=50
IOWeight=100
