{
  "name": "dar-meet-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dar meet recorder bot: captures the virtual display and audio, then reports to Dar.Api.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "selftest": "node dist/index.js --selftest",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.7.2",
    "vitest": "^5.1.0"
  }
}
