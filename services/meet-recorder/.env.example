# Dar meet recorder — copy to /etc/dar/meet-bot.env (chmod 0640 root:dar).
# The bot never stores Google credentials: Chrome keeps its own profile on disk.

# Control plane: Dar.Api on loopback. nginx returns 404 for /internal/* on both the
# production and staging vhosts, so the bot control plane is never proxied publicly.
DAR_API_URL=http://127.0.0.1:5081
DAR_SERVICE_TOKEN=change-me-32-bytes

# Recorder identity + storage.
BOT_WORKER_NAME=dar-meet-bot-1
BOT_MEDIA_ROOT=/var/lib/dar/media/meet
# Chrome profile with the signed-in owner account (managed manually on the server).
BOT_PROFILE_DIR=/var/lib/dar/meet/profile
# video = MP4 + HLS + poster (screen capture); audio = parecord + AAC/MP4 only (lighter).
BOT_RECORD_MODE=video

# Virtual display / capture.
BOT_DISPLAY=99
BOT_WIDTH=1280
BOT_HEIGHT=720
# 15 is plenty for slides/whiteboard and halves the FFmpeg load (30 made FFmpeg fall behind real time).
BOT_FRAMERATE=15
BOT_VIDEO_BITRATE=2500k
BOT_VIDEO_PRESET=ultrafast
BOT_VIDEO_THREADS=3
BOT_AUDIO_BITRATE=128k

# Diagnostics for choppy audio: audio.wav is recorded next to recording.mp4 by a separate
# parecord (about 11 MB per minute). Set BOT_AUDIO_TAP=0 once the cause is settled.
BOT_AUDIO_TAP=1
# PULSE_LATENCY_MSEC for Chromium only (0 = leave unset).
BOT_CHROME_PULSE_LATENCY_MS=60
# Chromium --audio-buffer-size (samples). This is the fix for choppy audio: lab test under
# load gave 232 gaps/min with the default and 0 with 16384. 0 = Chromium default.
BOT_CHROME_AUDIO_BUFFER=16384

# Safety: refuse to start below this free space (ADR-0007), and stop a lesson that runs
# out of space while recording.
BOT_DISK_BLOCK_GB=25
BOT_DISK_STOP_GB=10

# Retention: keep MP4 archives; prune HLS folders and stale .runtime/job-* dirs.
BOT_HLS_RETENTION_DAYS=30
BOT_RUNTIME_RETENTION_HOURS=24

# Idle detection: require this many consecutive low-activity readings before stopping.
BOT_IDLE_CONFIRM_TICKS=3
# Auto-admit is restricted to complete labels on visible controls; 0 disables it entirely.
BOT_AUTO_ADMIT=1

# Terminal status reports retry with backoff; when Dar.Api is unreachable they wait in
# .runtime/outbox/ (max attempts before the job is reported as failed).
BOT_OUTBOX_MAX_ATTEMPTS=5

# Loops.
BOT_POLL_MS=5000
BOT_HEARTBEAT_MS=15000
BOT_LOG_LEVEL=info

# Self test duration (phase 3.2 acceptance).
BOT_SELFTEST_SECONDS=30
