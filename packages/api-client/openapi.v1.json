          "guardianPhone",
          "joinedOn",
          "status",
          "notes",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "studentCode": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "ageYears": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
